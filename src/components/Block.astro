---
// A single isometric block, used as a small decorative icon.
interface Props {
  colors: [top: string, left: string, right: string];
  class?: string;
}

const { colors, class: className = 'size-8' } = Astro.props;
const [top, left, right] = colors;
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true">
  <polygon points="16,3 28,9.5 16,16 4,9.5" fill={top} />
  <polygon points="4,9.5 16,16 16,29.5 4,23" fill={left} />
  <polygon points="16,16 28,9.5 28,23 16,29.5" fill={right} />
</svg>
